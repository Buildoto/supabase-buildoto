# ======================================================================
# Supabase on Coolify - Pre-configured defaults
# CHANGE THESE VALUES BEFORE GOING TO PRODUCTION!
# ======================================================================

# --- Secrets ---
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated
LOGFLARE_API_KEY=your-super-secret-and-long-logflare-key
LOGFLARE_PRIVATE_KEY=your-super-secret-and-long-logflare-private-key
PG_META_CRYPTO_KEY=your-super-secret-and-long-pg-meta-crypto-key
SUPAVISOR_SECRET=your-super-secret-and-long-supavisor-secret-base-key-that-is-at-least-64-chars
VAULT_ENC_KEY=your-super-secret-32-char-key!!
REALTIME_SECRET=your-super-secret-and-long-realtime-secret-base-key-that-is-at-least-64-characters

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123456

# --- API Keys (demo keys signed with the JWT_SECRET above) ---
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Public URL (change to your actual Coolify domain) ---
SUPABASE_PUBLIC_URL=http://localhost:8000

# --- Optional: Opaque API Keys ---
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# --- Database ---
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOSTNAME=supabase-db

# --- JWT ---
JWT_EXPIRY=3600

# --- Auth ---
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

# --- SMTP (disabled by default - set to enable email auth) ---
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase

# --- Email Templates ---
MAILER_TEMPLATES_INVITE=
MAILER_TEMPLATES_CONFIRMATION=
MAILER_TEMPLATES_RECOVERY=
MAILER_TEMPLATES_MAGIC_LINK=
MAILER_TEMPLATES_EMAIL_CHANGE=
MAILER_SUBJECTS_CONFIRMATION=
MAILER_SUBJECTS_RECOVERY=
MAILER_SUBJECTS_MAGIC_LINK=
MAILER_SUBJECTS_EMAIL_CHANGE=
MAILER_SUBJECTS_INVITE=

# --- PostgREST ---
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# --- Studio ---
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
OPENAI_API_KEY=

# --- Edge Functions ---
FUNCTIONS_VERIFY_JWT=false

# --- Pooler ---
POOLER_TENANT_ID=dev_tenant
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# --- Storage ---
STORAGE_TENANT_ID=storage-single-tenant
IMGPROXY_AUTO_WEBP=true
