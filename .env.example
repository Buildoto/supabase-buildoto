# ======================================================================
# Supabase on Coolify - Environment Variables
# ======================================================================
# Copy this file to .env and fill in the values.
# In Coolify, set these as environment variables in the service settings.
#
# Variables prefixed with SERVICE_PASSWORD_ are auto-generated by Coolify
# when using the native template. When deploying from GitHub, you must
# set them manually in Coolify's environment variables panel.
# ======================================================================

# --- Secrets (generate strong random values for each) ---
SERVICE_PASSWORD_POSTGRES=your-super-secret-postgres-password
SERVICE_PASSWORD_JWT=your-super-secret-jwt-token-with-at-least-32-characters-long
SERVICE_PASSWORD_ADMIN=your-dashboard-password
SERVICE_USER_ADMIN=supabase
SERVICE_PASSWORD_LOGFLARE=your-logflare-api-key
SERVICE_PASSWORD_LOGFLAREPRIVATE=your-logflare-private-key
SERVICE_PASSWORD_PGMETACRYPTO=your-pg-meta-crypto-key
SERVICE_PASSWORD_SUPAVISORSECRET=your-supavisor-secret-base-at-least-64-chars
SERVICE_PASSWORD_VAULTENC=your-vault-encryption-key-must-be-32-chars
SECRET_PASSWORD_REALTIME=your-realtime-secret-base-at-least-64-chars

# --- MinIO (S3-compatible storage) ---
SERVICE_USER_MINIO=minioadmin
SERVICE_PASSWORD_MINIO=your-minio-password

# --- API Keys ---
# Generate these using: https://supabase.com/docs/guides/self-hosting#api-keys
SERVICE_SUPABASEANON_KEY=your-anon-key
SERVICE_SUPABASESERVICE_KEY=your-service-role-key

# --- Public URL ---
# Set this to your Coolify domain for the Kong service
SERVICE_URL_SUPABASEKONG=https://your-supabase-domain.com

# --- Optional: Opaque API Keys (leave empty if not using) ---
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# --- Database ---
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOSTNAME=supabase-db

# --- JWT ---
JWT_EXPIRY=3600

# --- Auth ---
GOTRUE_SITE_URL=https://your-app-domain.com
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

# --- SMTP (for email auth) ---
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SENDER_NAME=Supabase

# --- Email Templates (optional) ---
MAILER_TEMPLATES_INVITE=
MAILER_TEMPLATES_CONFIRMATION=
MAILER_TEMPLATES_RECOVERY=
MAILER_TEMPLATES_MAGIC_LINK=
MAILER_TEMPLATES_EMAIL_CHANGE=
MAILER_SUBJECTS_CONFIRMATION=
MAILER_SUBJECTS_RECOVERY=
MAILER_SUBJECTS_MAGIC_LINK=
MAILER_SUBJECTS_EMAIL_CHANGE=
MAILER_SUBJECTS_INVITE=

# --- PostgREST ---
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# --- Studio ---
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
OPENAI_API_KEY=

# --- Edge Functions ---
FUNCTIONS_VERIFY_JWT=false

# --- Pooler ---
POOLER_TENANT_ID=dev_tenant
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# --- Storage ---
STORAGE_TENANT_ID=storage-single-tenant
IMGPROXY_AUTO_WEBP=true
